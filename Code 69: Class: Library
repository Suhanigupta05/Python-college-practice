# WAP that allows a librarian to add several books to library. For each book, ask the user to enter its title amd the number of copies
# Store each book and its available copies count in a dictionary.

# book cab ne issued if required book with number of copies required are available
# can't be returned if not in library


class Libraray:
    def ___init___(self):
        self.books={}

    def add(self):
        while True:
            title=input("Enter book title:")
            copies=int(input("Enter number of copies to add:"))
    
            if title in self.books:
                print("Book already in Library.")
                self.books[title]+=copies
            else:
                self.books[title]=copies

            reply=input("Do you want to add more books [y/n]:")
            if(reply=="n"):
                break
    def issue(self):
        title=input("Enter book title:")
        copies=int(input("Enter number of copies to issue:"))

        if title in self.books and self.books[title]>=copies:
            print("Book Issued in Successfully!!!.")
            self.books[title]-=copies
        else:
            print("Book not available in Library! can't be issued!!!")

    def returnn(self):
        title=input("Enter book title:")
        copies=int(input("Enter numbers of copy to be returned: "))
        if title in self.books:
            print("Book Returned Successfully!!!.")
            self.books[title]+=copies
        else:
            print("Book not in Library. Can't be returned!")

        
    def display(self):
        print(self.books)


library=Libraray()
library.add()
library.issue()
library.returnn()
library.display()

