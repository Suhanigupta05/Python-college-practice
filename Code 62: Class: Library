# WAP that allows a librarian to add several books to library. For each book, ask the user to enter its title amd the number of copies
# Store each book and its available copies count in a dictionary.

class Libraray:
    def ___init___(self):
        self.books={}

    def add(self):
        while True:
            title=input("Enter book title:")
            copies=int(input("Enter number of copies:"))
    
            if title in  self.books:
                print("Book already in Library.")
                self.books[title]+=copies
            else:
                self.books[title]=copies

            reply=input("Do you want to add more books [y/n]:")
            if(reply=="n"):
                break

    def display(self):
        print(self.books)


library=Libraray()
library.add()
library.display()

