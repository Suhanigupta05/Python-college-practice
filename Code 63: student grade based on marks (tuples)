# Store one student's data as a simple, direct tuple
student = ("Abcd", 3, (90, 80, 40, 70))

# Unpack the tuple directly into variables
name, roll_no, marks = student

# Calculate the exact average using standard division
average = sum(marks) / len(marks)

# Display the student's info and average
print(f"Student: {name} (Roll No: {roll_no})")
print(f"Average Marks: {average:.2f}")

# Determine and display the grade based on non-overlapping boundaries
if average >= 90:
    print("Grade: A+")
elif average >= 80:
    print("Grade: A")
elif average >= 50:
    print("Grade: B")
else:
    print("Grade: F")
