# WAP to take 2 list input then store their common ele in list3


n=int(input("Enter number of elements to push in a list1:"))
listt1=[]

for i in range(n):
  o=int(input("Enter element:"))
  listt1.append(o)

m=int(input("Enter number of elements to push in a list2:"))
listt2=[]

for i in range(m):
  o=int(input("Enter element:"))
  listt2.append(o)

listt3=[]
  
for i in listt1:
  for j in listt2 and not in listt3:
    if i in j:
      listt3.append(i)

print(f"Elements common among list1 & list2 are: {listt3}")
      
